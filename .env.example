# Copia este archivo a .env (ignorado por git) para probar con `npx netlify dev`.
# En producción estas variables se configuran en Netlify (Site settings → Environment variables).
# NUNCA pongas valores reales en este archivo.
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
# Contraseña del panel (mínimo 16 caracteres). También sirve como x-api-key en Postman.
ADMIN_PASSWORD=
# 64 caracteres hexadecimales para firmar la sesión del panel (por ejemplo: openssl rand -hex 32)
ADMIN_TOKEN_SECRET=
# Sal para hashear IPs (la IP real nunca se guarda)
IP_HASH_SALT=
